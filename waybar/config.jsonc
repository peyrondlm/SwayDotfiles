{
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 4,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["sway/workspaces", "custom/sep", "sway/window"],
  "modules-center": [],
  "modules-right": [
    "wireplumber", "custom/sep#a",
    "memory", "custom/sep#b",
    "cpu", "custom/sep#c",
    "battery", "custom/sep#d",
    "clock#date", "custom/sep#e",
    "clock#hour", "custom/sep#f",
    "keyboard-state",
    "custom/language",
    "custom/screenshot",
    "custom/powermenu",
    "tray"
  ],

  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [],
      "5": [], "6": []
    }
  },

  "custom/sep": {
    "format": "|",
    "tooltip": false
  },
  "custom/sep#a": { "format": "|", "tooltip": false },
  "custom/sep#b": { "format": "|", "tooltip": false },
  "custom/sep#c": { "format": "|", "tooltip": false },
  "custom/sep#d": { "format": "|", "tooltip": false },
  "custom/sep#e": { "format": "|", "tooltip": false },
  "custom/sep#f": { "format": "|", "tooltip": false },

  "sway/window": {
    "format": "{title}",
    "max-length": 50
  },

  "wireplumber": {
    "format": "<span foreground='#e3c78a'>VOL</span> {volume}%",
    "format-muted": "<span foreground='#e3c78a'>VOL</span> muted",
    "on-click": "pavucontrol"
  },

  "memory": {
    "interval": 2,
    "format": "<span foreground='#e3c78a'>RAM</span> {percentage}%",
    "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G"
  },

  "cpu": {
    "interval": 2,
    "format": "<span foreground='#e3c78a'>CPU</span> {usage}%",
    "tooltip": false
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "ACAD",
    "interval": 30,
    "full-at": 99,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span foreground='#e3c78a'>BAT</span> {capacity}%",
    "format-charging": "<span foreground='#e3c78a'>BAT</span> {capacity}% (charging)",
    "format-plugged": "<span foreground='#e3c78a'>BAT</span> {capacity}% (charging)",
    "format-full": "<span foreground='#e3c78a'>BAT</span> Full"
  },

  "clock#date": {
    "interval": 60,
    "locale": "es_MX.UTF-8",
    "format": "{:L%a %d %b}",
    "tooltip-format": "{:L%A, %d %B %Y}",
    "on-click": "gsimplecal"
  },

  "clock#hour": {
    "interval": 1,
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%Y-%m-%d %I:%M:%S %p}"
  },

  "keyboard-state": {
    "numlock": false,
    "capslock": true,
    "scrolllock": false,
    "format": "{icon}",
    "format-icons": {
      "locked": "Caps",
      "unlocked": ""
    }
  },

  "custom/language": {
    "exec": "~/.config/sway/scripts/keylayout",
    "interval": 1,
    "on-click": "swaymsg input '*' xkb_switch_layout next",
    "tooltip": false
  },

  "custom/screenshot": {
    "format": "󰻛",
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/screenshot region"
  },

  "custom/powermenu": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/power"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
