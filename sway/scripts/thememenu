#!/bin/bash
# thememenu — Sway theme switcher.
# Reads themes from ~/.config/sway/themes/<name>/ (theme.conf + colors.css) and swaps:
#   - Sway border colors   (colors.conf, generated from the palette)
#   - Waybar + wofi palette (THEME block in waybar/style.css and wofi/style.css)
#   - Alacritty scheme     (current-theme.toml)
#   - GTK theme + icons    (settings.ini + gsettings)
#   - Wallpaper            (wallpaper.conf)
#   - Dunst colors         (dunstrc)
#   - Neovim colorscheme   (lua/theme.lua)
# Then reloads sway, Waybar and dunst.

set -u

export PATH="$HOME/.local/bin:$PATH"

SWAY_DIR="$HOME/.config/sway"
THEMES_DIR="$SWAY_DIR/themes"
ALACRITTY_DIR="$HOME/.config/alacritty"
ACTIVE_THEME_FILE="$HOME/.cache/sway/current_theme"

ACTIVE_SWAY_COLORS="$SWAY_DIR/colors.conf"
WAYBAR_STYLE="$HOME/.config/waybar/style.css"
WAYBAR_CONFIG="$HOME/.config/waybar/config.jsonc"
WOFI_STYLE="$HOME/.config/wofi/style.css"
DUNSTRC="$SWAY_DIR/dunst/dunstrc"
NVIM_THEME="$HOME/.config/nvim/lua/theme.lua"

GTK3_CONF="$HOME/.config/gtk-3.0/settings.ini"
WALLPAPER_DIR="$SWAY_DIR/wallpaper"

mkdir -p "$(dirname "$ACTIVE_THEME_FILE")"

# === HELPERS ===

cfg_get() {
  awk -v k="$2" '
        $0 !~ /^[[:space:]]*#/ {
            n = index($0, "=")
            if (n > 0) {
                key = substr($0, 1, n-1); val = substr($0, n+1)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
                if (key == k) { print val; exit }
            }
        }' "$1"
}

notify() { notify-send -a "Theme" -u "${2:-normal}" -t "${3:-2000}" "Theme" "$1"; }

# palette_get FILE KEY — read a @define-color value from a theme's colors.css.
palette_get() {
  awk -v k="$2" '/^@define-color/{gsub(/;/,"",$3); if ($2==k){print $3; exit}}' "$1"
}

# replace_block FILE BLOCKFILE TAG — replace everything between
# "/* TAG:BEGIN */" and "/* TAG:END */" with the contents of BLOCKFILE.
replace_block() {
  awk -v block="$2" -v tag="$3" '
        $0 == "/* " tag ":BEGIN */" {
            print
            while ((getline line < block) > 0) print line
            close(block)
            skip = 1
            next
        }
        $0 == "/* " tag ":END */" { skip = 0; print; next }
        skip == 1 { next }
        { print }
    ' "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

# === MAIN ===

current=$(cat "$ACTIVE_THEME_FILE" 2>/dev/null || echo "moonfly")

declare -A name_to_dir
menu=""
for d in "$THEMES_DIR"/*/; do
  [ -f "$d/theme.conf" ] || continue
  t=$(basename "$d")
  display=$(cfg_get "$d/theme.conf" name)
  display=${display:-$t}
  name_to_dir["$display"]="$t"
  menu+="$display"$'\n'
done

if [ "${1:-}" ]; then
  target="$1"
else
  chosen=$(printf '%s' "$menu" | sort |
    wofi --dmenu --insensitive --prompt "Theme ($current)" --cache-file /dev/null --columns 1)
  [ -z "$chosen" ] && exit 0
  target="${name_to_dir[$chosen]:-$chosen}"
fi

THEME_DIR="$THEMES_DIR/$target"
[ -d "$THEME_DIR" ] || {
  notify "Missing theme: $target" critical
  exit 1
}

CONF="$THEME_DIR/theme.conf"
[ -r "$CONF" ] || {
  notify "Missing $CONF" critical
  exit 1
}

display_name=$(cfg_get "$CONF" name)
display_name=${display_name:-$target}

if [ "$current" = "$target" ]; then
  notify "Already using $display_name" low 1500
  exit 0
fi

# 1. Sway border colors
CSS="$THEME_DIR/colors.css"
if [ -f "$CSS" ]; then
  bg=$(palette_get "$CSS" bg)
  fg=$(palette_get "$CSS" fg)
  secondary=$(palette_get "$CSS" secondary)
  alert=$(palette_get "$CSS" alert)
  disabled=$(palette_get "$CSS" disabled)
  highlight=$(cfg_get "$CONF" dunst_highlight_normal)
  cat >"$ACTIVE_SWAY_COLORS" <<EOF
# Auto-generated by thememenu from themes/$target/colors.css — do not edit.
# class                 border  backgr. text    indicator child_border
client.focused          $secondary $secondary $bg $highlight $secondary
client.focused_inactive $bg $bg $disabled $bg $bg
client.unfocused        $bg $bg $fg $bg $bg
client.urgent           $alert $alert $bg $alert $alert
client.placeholder      $bg $bg $fg $bg $bg
client.background       $bg
EOF
fi

# 2. Waybar palette
if [ -f "$CSS" ] && [ -f "$WAYBAR_STYLE" ]; then
  replace_block "$WAYBAR_STYLE" "$CSS" "THEME"
fi

# 2b. Waybar module-prefix accent
if [ -f "$CSS" ] && [ -f "$WAYBAR_CONFIG" ]; then
  accent=$(palette_get "$CSS" accent)
  if [ -n "$accent" ]; then
    sed -i -E \
      "s@<span foreground='#[0-9a-fA-F]{6}'>(VOL|RAM|CPU|BAT)</span>@<span foreground='$accent'>\1</span>@g" \
      "$WAYBAR_CONFIG"
  fi
fi

# 3. Wofi palette
if [ -f "$CSS" ] && [ -f "$WOFI_STYLE" ]; then
  replace_block "$WOFI_STYLE" "$CSS" "THEME"
fi

# 4. Alacritty scheme
alacritty_theme=$(cfg_get "$CONF" alacritty)
if [ -n "$alacritty_theme" ] && [ -f "$ALACRITTY_DIR/themes/$alacritty_theme.toml" ]; then
  cp "$ALACRITTY_DIR/themes/$alacritty_theme.toml" "$ALACRITTY_DIR/current-theme.toml"
fi

# 5. GTK theme + icons
gtk=$(cfg_get "$CONF" gtk)
icons=$(cfg_get "$CONF" icons)
if [ -f "$GTK3_CONF" ]; then
  [ -n "$gtk" ] && sed -i "s|^gtk-theme-name=.*|gtk-theme-name=${gtk}|" "$GTK3_CONF"
  [ -n "$icons" ] && sed -i "s|^gtk-icon-theme-name=.*|gtk-icon-theme-name=${icons}|" "$GTK3_CONF"
fi
if command -v gsettings >/dev/null 2>&1; then
  [ -n "$gtk" ] && { gsettings set org.gnome.desktop.interface gtk-theme "$gtk" 2>/dev/null || true; }
  [ -n "$icons" ] && { gsettings set org.gnome.desktop.interface icon-theme "$icons" 2>/dev/null || true; }
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true
fi

# 5b. Neovim colorscheme (nvim reads lua/theme.lua on startup)
nvim_cs=$(cfg_get "$CONF" nvim)
if [ -n "$nvim_cs" ] && [ -d "$(dirname "$NVIM_THEME")" ]; then
  printf 'return "%s"\n' "$nvim_cs" >"$NVIM_THEME"
fi

# 6. Wallpaper
wp=$(cfg_get "$CONF" wallpaper)
if [ -n "$wp" ] && [ -f "$WALLPAPER_DIR/$wp" ]; then
  printf 'output * bg %s fill\n' "$WALLPAPER_DIR/$wp" >"$SWAY_DIR/wallpaper.conf"
fi

# 7. Dunst
for k in frame_global bg_low fg_low frame_low highlight_low \
  bg_normal fg_normal frame_normal highlight_normal \
  bg_critical fg_critical frame_critical highlight_critical; do
  v=$(cfg_get "$CONF" "dunst_$k")
  [ -n "$v" ] && sed -i "/# THEME: dunst_$k\$/s/\"#[0-9a-fA-F]*\"/\"$v\"/" "$DUNSTRC"
done

# 8. Reload sway, Waybar and dunst
swaymsg reload >/dev/null 2>&1 || true
systemctl --user reload sway-waybar.service 2>/dev/null || pkill -USR2 -x waybar 2>/dev/null || true
pkill -x dunst 2>/dev/null || true
dunst -config "$DUNSTRC" >/dev/null 2>&1 &

# 9. Persist
echo "$target" >"$ACTIVE_THEME_FILE"

# 10. Notify once dunst is back on D-Bus
sleep 0.5
notify "Switched to $display_name"
